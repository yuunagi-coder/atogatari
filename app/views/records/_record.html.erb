<div id="<%= dom_id record %>" class="flex flex-col justify-center items-center m-4 p-4 mx-auto">
  <div>
    <p class="text-xl m-1">
      <%= record.spot_name %>
    </p>
  </div>
  <div class="items-right text-l">
    <p>
      <%= record.recorded_at.strftime("%Y年%m月%d日") %>
    </p>
  </div>
  <div class="items-right text-l">
    <p>
      <%= record.memo %>
    </p>
  </div>
  <% if record.photo.present? %>
    <div class="m-4 items-center">
      <%= image_tag record.photo,
        class: "img-resize, rounded mx-auto d-block",
        style: "width: 50%; height: 100%; object-fit: contain;"
        %>
    </div>  
  <% end %>
</div>
