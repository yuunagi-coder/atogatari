<div class="flex flex-col justify-center items-center h-screen w-full">
  <h1 class="text-3xl">記録一覧</h1>
  <%= render 'shared/flash_message' %>
  <div id="records" class="mx-auto w-4/5 max-w md">
    <%= render 'shared/search', q: @q, url: records_path %>
    <% if @records.any? %>
      <% @records.each do |record| %>
        <%= link_to record, class: "block" do %>
          <%= render partial: 'records', locals: { record: record } %>
        <% end %>
      <% end %>
    <% else %>
      <div class="flex flex-col justify-center mx-auto items-center">
        <p class="text-xl text-center m-10">思い出が記録されていないようです</p>
        <%= link_to "記録する", new_record_path, class:"btn bg-yellow-500 hover:bg-yellow-600 font-bold py-2 px-4 rounded w-1/5 text-center" %>
      </div>
    <% end %>
    <%= link_to "戻る", 'javascript:history.back()', class: "py-2 px-4 items-left" %>
  </div>
</div>
