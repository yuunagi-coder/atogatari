<div id="<%= dom_id record %>" class="relative flex m-4 border-b border-slate-900 p-4">
  <div class="flex flex-col">
    <div>
      <p class="text-xl m-1">
        <%= record.spot_name %>
      </p>
    </div>
    <div class="items-right text-l">
      <p>
        <%= record.recorded_at.strftime("%Y年%m月%d日") %>
      </p>
    </div>
    <div class="flex">
      <%= record.photo %>
    </div>
  </div>
</div>

