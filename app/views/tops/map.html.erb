<div class="flex flex-col md:w-5/6 max-md:h-5/6">
<div class="flex justify-left items-center top-0 right-0 z-50 md:h-1/9 h-1/8 p-3 bg-amber-50 ">
  <h1 class="m-4 md:hidden">あとがたり</h1>
  <%= render 'shared/search', q: @q, url: root_path %>
</div>
<div id='map' class="relative md:h-8/9 h-7/8 w-full">
</div>
<%= render "modal" %>
</div>

<% content_for :head_scripts do %>
  <script>
    (g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})({
      key: "<%= Rails.application.credentials.dig(:google, :api_key) %>",
      v: "weekly",
    });
  </script>
<% end %>

<script>
  var map;
  var markers = [];
  var AdvancedMarkerElement;

  function clearMarkers(){
    markers.forEach(m => m.map =null);
    markers = [];
  }
// マーカー表示
function renderMarkers(records){
  clearMarkers();

  records.forEach(record => {
    const marker = new AdvancedMarkerElement({
      map,
      title: record.spot_name,
      position: { lat: Number(record.latitude), lng: Number(record.longitude) },
      gmpClickable: true,
    });

    marker.addEventListener('gmp-click', () => {
      const recorded_at = new Date(record.recorded_at);
      const formatted_recorded_at = `${recorded_at.getFullYear()}年${String(recorded_at.getMonth() + 1).padStart(2, '0')}月${String(recorded_at.getDate()).padStart(2, '0')}日`
      document.getElementById("modal_spot_name").textContent = record.spot_name;
      document.getElementById("modal_recorded_at").textContent = formatted_recorded_at;
      document.getElementById("modal_memo").textContent = record.memo;

      const detailButton = document.getElementById("modal_detail_button");
      detailButton.onclick = () => {
        window.location.href = `/records/${record.id}`;
      };

      document.getElementById("markerModal").classList.remove("hidden");
    });

    markers.push(marker);
  });
}
   
  async function init(){
    // マップ表示
    const { Map } = await google.maps.importLibrary("maps");
    const markerLib = await google.maps.importLibrary("marker");
    AdvancedMarkerElement = markerLib.AdvancedMarkerElement;

    map = new Map(document.getElementById('map'),{
        center: { lat: 35.68147, lng: 139.76696 },
        zoom: 13,
        mapId: "532c446984615091d0036809"
    });

    // モーダル表示 
    const modal = document.getElementById("markerModal");
    const modal_close = document.getElementById('modal_close');
    modal_close.addEventListener('click', function(){
      modal.classList.add("hidden");
    });

    // マーカー表示
    <% if @records.any? %>
      renderMarkers(<%= raw @records.to_json %>);
    <% end %>
  }
  
  document.addEventListener("turbo:load",() => {
   if(window.google?.maps){
     init();
    }
  });

  init();

</script>
