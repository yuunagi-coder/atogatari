<h1>MAP</h1>
<%= button_to "ログアウト", session_path, method: :delete, form: { data: { turbo_confirm: 'ログアウトしますか？'}} %>
<%= link_to "新規作成", new_record_path %>
<%= link_to "一覧", records_path %>
<div id='map' class="h-screen w-full"></div>

<script>
  let map

  function initMap(){
    map = new google.maps.Map(document.getElementById('map'),{
      center: { lat: 40.7828, lng: -73.9653 },
      zoom: 13
    });
    
    marker = new google.maps.Marker({
      position: { lat: 40.7828, lng: -73.9653 },
      map: map
    });
  }
</script>
<script async defer data-turbo-track="reload"
                    src="https://maps.googleapis.com/maps/api/js?loading=async&key=<%= Rails.application.credentials.dig(:google, :api_key) %>&libraries=maps,marker&callback=initMap">
</script>
