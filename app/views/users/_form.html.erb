<%= form_with model: @user, url: user_path do |form| %>
  <% if @user.errors.any? %>
    <div class="text-red-400">
      <h2><%= user.errors.count %>件のエラーがあります</h2>
      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="flex flex-col mx-auto w-full space-y-4 mt-8 mb-8">
    <div class="mb-4">
      <%= form.label :name, class: "block required" %>
      <%= form.text_field :name, class: 'form-control bg-white round mt-2 p-2 w-full' %>
    </div> 
    <div class="mb-4">
      <%= form.label :email_address, class: "block required" %>
      <%= form.email_field :email_address, class: 'form-control bg-white mt-2 p-2 w-full' %>
    </div> 
    <div class="mb-4">
      <%= form.label :password, class: "block required" %>
      <%= form.password_field :password, class: 'form-control bg-white mt-2 p-2 w-full' %>
    </div> 
    <div class="mb-4">
      <%= form.label :password_confirmation, class: "block required" %>
      <%= form.password_field :password_confirmation, class: 'form-control bg-white mt-2 p-2 w-full' %>
    </div> 
    <div>
      <%= form.submit class: 'btn bg-yellow-500 hover:bg-yellow-600 font-bold py-2 px-4 rounded w-full'%>
    </div> 
  </div>
<% end %>
